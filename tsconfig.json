{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@kiwi/core": ["packages/core/src/index.ts"],
      "@kiwi/ledger": ["packages/ledger/src/index.ts"],
      "@kiwi/metrics": ["packages/metrics/src/index.ts"],
      "@kiwi/model-router": ["packages/model-router/src/index.ts"],
      "@kiwi/report-spec": ["packages/report-spec/src/index.ts"],
      "@kiwi/planner": ["packages/planner/src/index.ts"],
      "@kiwi/store": ["packages/store/src/index.ts"],
      "@kiwi/client": ["packages/client/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "apps/mcp/src/**/*.ts",
    "apps/mcp/test/**/*.ts",
    "vitest.config.ts"
  ]
}
