{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiwi.finance/schema/report-spec/v1.json",
  "title": "Kiwi Report Spec",
  "description": "What a planning model is allowed to emit. It describes which figures to compute, never what they are. Anything outside this schema is rejected rather than approximated (PRD FR-ANA-02).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "period", "blocks"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "period": { "$ref": "#/$defs/period" },
    "baseCurrency": { "$ref": "#/$defs/currency" },
    "fxMode": {
      "enum": ["transaction", "reporting"],
      "default": "transaction",
      "description": "transaction = the rate that actually happened; reporting = one common rate across the period."
    },
    "filters": { "$ref": "#/$defs/filters" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/date" },
        "to": { "$ref": "#/$defs/date" },
        "compareTo": { "enum": ["previous_period", "previous_year"] }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currencies": { "type": "array", "items": { "$ref": "#/$defs/currency" }, "maxItems": 20 },
        "accountIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 50 },
        "categoryIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 100 },
        "excludeCategoryIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 100 },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 40 }, "maxItems": 20 }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/metricRowBlock" },
        { "$ref": "#/$defs/chartBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/narrativeBlock" }
      ]
    },
    "metricRowBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "metrics"],
      "properties": {
        "type": { "const": "metric_row" },
        "title": { "type": "string", "maxLength": 80 },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "chartBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "viz", "metric"],
      "properties": {
        "type": { "const": "chart" },
        "title": { "type": "string", "maxLength": 80 },
        "viz": { "enum": ["bar", "stacked_bar", "line", "donut"] },
        "metric": { "type": "string", "minLength": 1, "maxLength": 64 },
        "params": { "type": "object", "additionalProperties": { "type": ["number", "string"] } }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "metric"],
      "properties": {
        "type": { "const": "table" },
        "title": { "type": "string", "maxLength": 80 },
        "metric": { "type": "string", "minLength": 1, "maxLength": 64 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "params": { "type": "object", "additionalProperties": { "type": ["number", "string"] } }
      }
    },
    "narrativeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "narrative" },
        "title": { "type": "string", "maxLength": 80 },
        "focus": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": [
              "summary",
              "anomalies",
              "trends",
              "fx_exposure",
              "budget",
              "subscriptions",
              "data_quality"
            ]
          }
        }
      }
    }
  }
}
