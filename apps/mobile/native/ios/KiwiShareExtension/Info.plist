<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>Kiwi</string>
  <key>CFBundleName</key>
  <string>KiwiShareExtension</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.share-services</string>
    <!-- No storyboard: the sheet is built in code, so there is one place the
         UI is defined and it is the same file that does the work. -->
    <key>NSExtensionPrincipalClass</key>
    <string>$(PRODUCT_MODULE_NAME).ShareViewController</string>
    <key>NSExtensionAttributes</key>
    <dict>
      <key>NSExtensionActivationRule</key>
      <dict>
        <!-- A screenshot or a photo of a receipt. -->
        <key>NSExtensionActivationSupportsImageWithMaxCount</key>
        <integer>10</integer>
        <!-- Selected text from a bank app or an email. -->
        <key>NSExtensionActivationSupportsText</key>
        <true/>
        <!-- A link to an order confirmation. -->
        <key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
        <integer>1</integer>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
